# Copy to .env and edit, or export these in your shell / hosting dashboard.
# (The relay reads process.env only. Use `node --env-file=.env dist/server.js`.)

PORT=8787

# The URL your phone and watch use to reach this relay (must be https for use away from home Wi-Fi).
PUBLIC_URL=http://192.168.1.50:8787

# Where the relay keeps its small JSON database. Back this folder up.
DATA_DIR=./data

# Optional. If unset, a random admin key is generated on first start and printed once.
# ADMIN_KEY=

# Default approval timeout in seconds (changeable later in the iPhone app).
APPROVAL_TIMEOUT_SECONDS=300

# Provider keys. You can also set a key per agent in the iPhone app instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Free push alternative: ntfy (works without a paid Apple Developer account) ---
# Use a long random topic name, it acts like a password.
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=agentwatch-change-me-to-something-long-and-random
# NTFY_TOKEN=

# --- APNs (needs a paid Apple Developer account) ---
# APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=YYYYYYYYYY
# APNS_TOPIC=com.example.agentwatch.watchkitapp

# Where the demo agent's decisions are delivered (used by the mock agent).
# DEMO_CALLBACK_URL=http://localhost:8788/callback
